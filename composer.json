{
    "name": "stayuptimistic/uptimistic-laravel",
    "description": "Tells your Uptimistic monitor what a Laravel app runs on: Laravel, PHP, the database and every package, with versions. Signed, read-only.",
    "keywords": ["laravel", "uptimistic", "monitoring", "security", "dependencies", "end-of-life"],
    "homepage": "https://github.com/stayuptimistic/uptimistic-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Drahos István"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Uptimistic\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uptimistic\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Uptimistic\\Laravel\\UptimisticServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
